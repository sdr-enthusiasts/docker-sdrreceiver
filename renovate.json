{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "default:pinDigestsDisabled"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0 1 * *"]
  },
  "timezone": "Etc/UTC",
  "schedule": ["* 0 1 * *"],
  "enabledManagers": ["nix", "github-actions", "dockerfile"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "automerge": true,
  "platformAutomerge": true,
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/sdr-enthusiasts/.*$/"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": [
        "jlesage base images tag as <distro>-v<major>.<minor>.<patch> (e.g.",
        "debian-13-v4.13.1), which the default docker versioning cannot parse,",
        "so Renovate silently never proposed an update. Parse it as regex",
        "versioning with the distro captured as <compatibility> so updates stay",
        "on the same distro line and never silently jump debian-13 -> ubuntu."
      ],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["jlesage/baseimage-gui"],
      "versioning": "regex:^(?<compatibility>.+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "enabled": true,
      "automerge": true
    }
  ]
}
